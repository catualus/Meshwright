<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A library, not an executable. Compile Pal publishes self-contained and cannot reference a
         non-self-contained exe, so the command line lives in NavPalCli and links this. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NavPal.Core</AssemblyName>
    <RootNamespace>NavPal</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

</Project>
