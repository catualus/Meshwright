<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A library, not an executable. Compile Pal publishes self-contained and cannot reference a
         non-self-contained exe, so the command line lives in MeshwrightCli and links this. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Meshwright.Core</AssemblyName>
    <RootNamespace>Meshwright</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- So a test can reach a parser that has no business being public. GameInfo.Parse takes text
         rather than a path, which is what makes it testable without a game install on the machine. -->
    <InternalsVisibleTo Include="Meshwright.Tests" />
  </ItemGroup>

</Project>
