<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A library, not an executable. Compile Pal publishes self-contained and cannot reference a
         non-self-contained exe, so the command line lives in MeshwrightCli and links this. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Meshwright.Core</AssemblyName>
    <RootNamespace>Meshwright</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The BSP and game-content readers live in SourceKit, shared with Viswright and Compile Pal, and
         checked out as a submodule. Set SourceKitRoot to build against another copy. -->
    <SourceKitRoot Condition="'$(SourceKitRoot)' == ''">$(MSBuildThisFileDirectory)..\external\SourceKit\</SourceKitRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceKitRoot)SourceKit\SourceKit.csproj" />
    <Using Include="SourceKit" />
  </ItemGroup>

  <ItemGroup>
    <!-- So a test can reach a parser that has no business being public. GameInfo.Parse takes text
         rather than a path, which is what makes it testable without a game install on the machine. -->
    <InternalsVisibleTo Include="Meshwright.Tests" />
  </ItemGroup>

</Project>
